# Command Center — copy to `.env` at repo root (gitignored). Never commit real passwords.

# =============================================================================
# Database (pick one — API reads DATABASE_URL only)
# =============================================================================

# Option A — Supabase (remote; recommended for now)
# Supabase → Project Settings → Database → Connection string → URI
# Prefer "Session pooler" or "Direct connection" for SQLx migrations on startup.
# Add sslmode=require. Percent-encode special characters in the password (@ → %40, etc.).
#
# DATABASE_URL=postgres://postgres.[project-ref]:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Option B — Docker Compose Postgres on this machine (see docker-compose.yml)
# docker compose up -d
# DATABASE_URL=postgres://cc:cc@127.0.0.1:5432/command_center

DATABASE_URL=postgres://cc:cc@127.0.0.1:5432/command_center

# Used by `docker compose` for the local Postgres container (not sent to Supabase)
CC_POSTGRES_USER=cc
CC_POSTGRES_PASSWORD=cc
CC_POSTGRES_DB=command_center
CC_POSTGRES_PORT=5432

# =============================================================================
# API
# =============================================================================
API_HOST=127.0.0.1
API_PORT=8080
WEB_ORIGIN=http://127.0.0.1:5173

# =============================================================================
# Web (optional — copy to apps/web/.env if you override the API URL)
# =============================================================================
# VITE_API_URL=http://127.0.0.1:8080
